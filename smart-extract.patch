+// "Extract Here (Smart)": only the shell extension (7-zip.dll) calls this, so it has no CompressCall2.cpp twin.
+void ExtractArchivesSmart(const UStringVector &arcPaths, const UString &outFolder, UInt32 writeZone)
+{
+  MY_TRY_BEGIN
+  UString params ('x');
+  if (!outFolder.IsEmpty())
+  {
+    params += " -o";
+    params += GetQuotedString(outFolder);
+  }
+  params += " -spx";
+  if (writeZone != (UInt32)(Int32)-1)
+  {
+    params += " -snz";
+    params.Add_UInt32(writeZone);
+  }
+  ExtractGroupCommand(arcPaths, params, false);
+  MY_TRY_FINISH_VOID
+}
+
 
