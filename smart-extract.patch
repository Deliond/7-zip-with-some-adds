diff --git a/add-smart-lang.ps1 b/add-smart-lang.ps1
new file mode 100644
index 0000000..fd460e8
--- /dev/null
+++ b/add-smart-lang.ps1
@@ -0,0 +1,24 @@
+# add-smart-lang.ps1 <carpeta Lang>
+# Agrega la traduccion de "Extract Here (Smart)" a los archivos de idioma de 7-Zip.
+# El numero 20000 es IDS_CONTEXT_EXTRACT_HERE_SMART (CPP/7zip/UI/Explorer/resource.h).
+# Formato (CPP/Common/Lang.cpp): una linea con el numero y, debajo, el texto. Los numeros deben ir en
+# orden ascendente, asi que se agrega al final del archivo. Si el orden fallara, 7-Zip descartaria ese idioma.
+# El archivo es solo ASCII a proposito: las letras con tilde se construyen con [char].
+
+param([Parameter(Mandatory = $true)][string]$LangDir)
+
+$id = 20000
+$texts = @{
+    'es' = "Extraer aqu$([char]0xED) (Inteligente)"
+}
+
+foreach ($lang in $texts.Keys) {
+    $file = Join-Path $LangDir "$lang.txt"
+    if (-not (Test-Path -LiteralPath $file)) { Write-Warning "No existe $file"; continue }
+    $bytes = [System.IO.File]::ReadAllBytes($file)
+    $text = [System.Text.Encoding]::UTF8.GetString($bytes)
+    if ($text -match "(?m)^$id\s*$") { continue }   # ya agregado
+    $prefix = if ($bytes.Length -gt 0 -and $bytes[$bytes.Length - 1] -ne 10) { "`n" } else { '' }
+    [System.IO.File]::AppendAllText($file, "$prefix$id`n$($texts[$lang])`n", (New-Object System.Text.UTF8Encoding($false)))
+    Write-Host "Traduccion agregada a $file"
+}
